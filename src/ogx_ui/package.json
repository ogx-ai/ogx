{
  "name": "ogx-ui",
  "version": "0.4.0-alpha.4",
  "description": "Web UI for OGX",
  "license": "MIT",
  "author": "OGX <contributors@ogx.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ogx-ai/ogx.git",
    "directory": "ogx_ui"
  },
  "bin": {
    "ogx-ui": "bin/cli.js"
  },
  "files": [
    "bin",
    ".next",
    "public",
    "next.config.ts",
    "instrumentation.ts",
    "tsconfig.json",
    "package.json"
  ],
  "scripts": {
    "dev": "next dev --turbopack --port ${OGX_UI_PORT:-8322}",
    "build": "next build && node scripts/postbuild.js",
    "start": "next start",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"./**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"./**/*.{ts,tsx}\"",
    "test": "jest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.2.0",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.4.0",
    "@types/papaparse": "^5.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "ogx-client": "^1.5.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remeda": "^2.51.0",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "overrides": {
    "postcss": "^8.5.26"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
