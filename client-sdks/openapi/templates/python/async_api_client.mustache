from __future__ import annotations

import re
import ssl

import httpx

from {{packageName}}.api_client import ApiClient
from {{packageName}}.configuration import Configuration
from {{packageName}}.exceptions import ApiException, ApiValueError
from {{packageName}} import rest


class AsyncApiClient(ApiClient):
    """Async API client that extends ApiClient with async HTTP transport.

    Inherits all serialization, deserialization, and parameter handling from
    ApiClient. Overrides only the HTTP transport layer (call_api, close, and
    context managers) to use httpx.AsyncClient for async I/O.

    :param configuration: Configuration object for this client
    :param header_name: Optional header to pass when making calls to the API
    :param header_value: Optional header value to pass when making calls to the API
    :param cookie: Optional cookie to include in the header when making calls to the API
    :param http_client: Optional pre-configured httpx.AsyncClient instance
    """

    def __init__(
        self,
        configuration: Configuration | None = None,
        header_name: str | None = None,
        header_value: str | None = None,
        cookie: str | None = None,
        http_client: httpx.AsyncClient | None = None,
    ) -> None:
        # Initialize the parent ApiClient (sets up configuration, default_headers,
        # cookie, user_agent, client_side_validation, and rest_client).
        # The rest_client is lazy so no sync httpx.Client is actually created.
        super().__init__(
            configuration=configuration,
            header_name=header_name,
            header_value=header_value,
            cookie=cookie,
        )

        # Set up the async HTTP client
        if http_client is not None:
            self._async_client = http_client
            self._async_client_provided = True
        else:
            self._async_client = None  # lazy initialization
            self._async_client_provided = False

    def _create_async_client(self) -> httpx.AsyncClient:
        """Create and configure httpx.AsyncClient instance."""
        configuration = self.configuration

        # Build SSL context (same as RESTClientObject)
        ssl_context = ssl.create_default_context(
            cafile=configuration.ssl_ca_cert,
            cadata=configuration.ca_cert_data,
        )
        if configuration.cert_file:
            ssl_context.load_cert_chain(
                configuration.cert_file, keyfile=configuration.key_file
            )
        if not configuration.verify_ssl:
            ssl_context.check_hostname = False
            ssl_context.verify_mode = ssl.CERT_NONE

        limits = httpx.Limits(
            max_connections=configuration.connection_pool_maxsize
        )

        timeout = configuration.timeout if configuration.timeout is not None else 5 * 60

        http2 = getattr(configuration, 'http2', False)

        proxy = None
        if configuration.proxy:
            proxy = httpx.Proxy(
                url=configuration.proxy,
                headers=configuration.proxy_headers
            )

        transport = None
        if configuration.retries is not None:
            transport = httpx.AsyncHTTPTransport(retries=configuration.retries)

        try:
            return httpx.AsyncClient(
                limits=limits,
                verify=ssl_context,
                proxy=proxy,
                transport=transport,
                http2=http2,
                timeout=timeout,
                trust_env=True,
                follow_redirects=getattr(configuration, 'follow_redirects', True),
            )
        except ImportError:
            if http2:
                raise ImportError(
                    "HTTP/2 support requires the 'h2' package. "
                    "Install it with: pip install h2"
                )
            raise

    @property
    def async_client(self) -> httpx.AsyncClient:
        """Lazy initialization of httpx.AsyncClient."""
        if self._async_client is None:
            self._async_client = self._create_async_client()
        return self._async_client

    async def __aenter__(self):
        """Async context manager entry."""
        return self

    async def __aexit__(self, exc_type, exc_value, traceback):
        """Async context manager exit."""
        await self.close()

    async def close(self):
        """Close the async HTTP client."""
        if self._async_client is not None and not self._async_client_provided:
            await self._async_client.aclose()
            self._async_client = None

    async def call_api(
        self,
        method,
        url,
        header_params=None,
        body=None,
        post_params=None,
        _request_timeout=None
    ) -> rest.RESTResponse:
        """Makes the HTTP request (asynchronous).

        Uses the same signature and return type as ApiClient.call_api so that
        generated API classes work identically.

        :param method: Method to call.
        :param url: Path to method endpoint.
        :param header_params: Header parameters to be placed in the request header.
        :param body: Request body.
        :param post_params: Request post form parameters.
        :param _request_timeout: timeout setting for this request.
        :return: RESTResponse
        """
        method = method.upper()
        assert method in [
            'GET', 'HEAD', 'DELETE', 'POST', 'PUT', 'PATCH', 'OPTIONS'
        ]

        if post_params and body:
            raise ApiValueError(
                "body parameter cannot be used with post_params parameter."
            )

        post_params = post_params or {}
        header_params = header_params or {}

        # Build request arguments
        args = {
            "method": method,
            "url": url,
            "headers": header_params,
        }

        # Handle timeout
        if _request_timeout is not None:
            if isinstance(_request_timeout, (int, float)):
                args["timeout"] = _request_timeout
            elif isinstance(_request_timeout, tuple) and len(_request_timeout) == 2:
                args["timeout"] = httpx.Timeout(
                    connect=_request_timeout[0], read=_request_timeout[1]
                )

        # Handle different content types
        if method in ['POST', 'PUT', 'PATCH', 'OPTIONS', 'DELETE']:
            content_type = header_params.get('Content-Type', '')

            if not content_type or re.search('json', content_type, re.IGNORECASE):
                if 'Content-Type' not in header_params:
                    header_params['Content-Type'] = 'application/json'
                if body is not None:
                    args["json"] = body
            elif content_type == 'application/x-www-form-urlencoded':
                args["data"] = dict(post_params)
            elif content_type == 'multipart/form-data':
                del header_params['Content-Type']

                files = []
                data = {}
                for param in post_params:
                    k, v = param
                    if isinstance(v, tuple) and len(v) == 3:
                        files.append((k, v))
                    elif isinstance(v, dict):
                        for subkey, subval in v.items():
                            data[f"{k}[{subkey}]"] = str(subval) if not isinstance(subval, str) else subval
                    else:
                        if isinstance(v, int):
                            v = str(v)
                        data[k] = v

                if files:
                    args["files"] = files
                if data:
                    args["data"] = data
            elif isinstance(body, (str, bytes)):
                args["content"] = body
            elif content_type.startswith('text/') and isinstance(body, bool):
                request_body = "true" if body else "false"
                args["content"] = request_body
            else:
                msg = """Cannot prepare a request message for provided
                         arguments. Please check that your arguments match
                         declared content type."""
                raise ApiException(status=0, reason=msg)

        request = self.async_client.build_request(**args)

        # Call _prepare_request hook if parent client has it
        if hasattr(self, '_parent_client') and self._parent_client is not None:
            if hasattr(self._parent_client, '_prepare_request'):
                result = self._parent_client._prepare_request(request)
                # Support both sync and async _prepare_request hooks
                if result is not None and hasattr(result, '__await__'):
                    await result

        try:
            r = await self.async_client.send(request, stream=True)
        except httpx.HTTPStatusError as e:
            raise ApiException(status=e.response.status_code, reason=str(e))
        except httpx.RequestError as e:
            raise ApiException(status=0, reason=str(e))

        return rest.RESTResponse(r)

    _default = None

    @classmethod
    def get_default(cls):
        """Return new instance of AsyncApiClient.

        This method returns a newly created instance based on the default
        constructor, or returns a copy of the default AsyncApiClient.

        :return: The AsyncApiClient object.
        """
        if cls._default is None:
            cls._default = AsyncApiClient()
        return cls._default

    @classmethod
    def set_default(cls, default):
        """Set default instance of AsyncApiClient.

        :param default: object of AsyncApiClient.
        """
        cls._default = default
